# ── Contact form (optional, safe to expose) ─────────────────────────────
# Free key from https://web3forms.com. Without a real key the form opens the
# visitor's email app with the message pre-filled instead.
VITE_WEB3FORMS_ACCESS_KEY=

# ── Narration generation (build time only; NEVER prefix these with VITE_) ─
# Put real values in .env.local, which git ignores. Set ONE provider.
# TTS_PROVIDER=google            # google | elevenlabs | openai (optional; auto-detected from keys)

# Google Cloud Text-to-Speech (monthly free tier; Indian English + Hindi voices)
GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE_EN=en-IN-Neural2-B
# GOOGLE_TTS_VOICE_HI=hi-IN-Neural2-B

# ElevenLabs (very natural voices; multilingual model speaks Hindi)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL=eleven_multilingual_v2

# OpenAI text-to-speech (paid)
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=onyx
